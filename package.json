{
  "name": "mini-orm",
  "version": "0.1.0",
  "private": true,
  "description": "Security-first, Prisma-like mini-ORM for TypeScript",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "mini-orm": "./dist/cli/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit tests/security tests/fuzz",
    "test:integration": "vitest run tests/integration",
    "test:types": "vitest run --typecheck.only --passWithNoTests",
    "coverage": "vitest run --coverage",
    "fixtures:update": "tsx scripts/update-fixtures.ts",
    "example:setup": "npm run build && node dist/cli/index.js generate --schema examples/blog/schema.orm --out examples/blog/generated && node dist/cli/index.js migrate --schema examples/blog/schema.orm --dir examples/blog/migrations",
    "example": "npm run example:setup && tsx examples/blog/index.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-plugin-security": "^4.2.0",
    "fast-check": "^4.10.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
